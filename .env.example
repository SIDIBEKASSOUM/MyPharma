# Copy to .env (git-ignored) and fill in. Used by `npm run scan-api`.
# The key stays on the server; the mobile app never sees it.
ANTHROPIC_API_KEY=

# Optional
# SCAN_API_PORT=3001
# SCAN_MODEL=claude-opus-5-5
# Where the app finds the scan API (default: the Expo dev machine, port 3001)
# EXPO_PUBLIC_SCAN_API_URL=http://192.168.1.30:3001
